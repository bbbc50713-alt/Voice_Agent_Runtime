# 语音服务镜像（hanxiaomi-zt-voice）
# 新增文件, 不修改本仓库任何冻结代码; 构建 context = Voice_Agent_Runtime 根
# 轻依赖(无 torch), 重活全在 dashscope 云端; SQLite 账本落 /app/data 卷
FROM python:3.11-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY SOUL.md ./SOUL.md
RUN mkdir -p /app/data

# DATABASE_URL 默认 sqlite:///./voice.db(相对 cwd); 显式指到卷内绝对路径
ENV DATABASE_URL=sqlite:////app/data/voice.db \
    PYTHONUNBUFFERED=1
VOLUME /app/data

EXPOSE 8200

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=10 \
  CMD curl -fsS http://127.0.0.1:8200/health || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8200"]
